{
	"schemaVersion": 1,
	"id": "skin-changer",
	"version": "${version}",
	"name": "pats-skin-changer",
	"description": "Change your skin, cape and elytra to whatever you want them to be!",
	"authors": [
		"Patatinus"
	],
	"contact": {
		"sources": "https://github.com/Patatinus/Skin-Changer"
	},
	"license": "CC0-1.0",
	"icon": "assets/skin-changer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.skinchanger.SkinChanger"
		],
		"client": [
			"com.skinchanger.client.SkinChangerClient"
		]
	},
	"mixins": [
		"skin-changer.mixins.json",
		{
			"config": "skin-changer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}